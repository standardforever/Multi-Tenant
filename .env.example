# App
APP_ENV=local
DEBUG=true
SECRET_KEY=change-me

# Postgres (used directly by the db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multitenant
POSTGRES_PORT=5432

# Full connection strings consumed by the api container.
# Change these to point at a different database/redis instance (e.g. managed cloud services).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/multitenant
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
