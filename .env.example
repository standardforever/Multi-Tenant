# App
APP_ENV=local
DEBUG=true
SECRET_KEY=change-me

# Postgres (used directly by the db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multitenant
POSTGRES_PORT=5432

# Full connection strings consumed by the api container.
# Change these to point at a different database/redis instance (e.g. managed cloud services).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/multitenant
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OAUTH_STATE_TTL_SECONDS=300

# Where to send the browser after a successful login (SPA route that reads
# access_token/refresh_token from the URL fragment).
FRONTEND_URL=http://localhost:3000

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email (Resend, https://resend.com) — used for organization invitations
RESEND_API_KEY=
EMAIL_FROM=Multi-Tenant <notifications@notify.processzero.co.uk>
INVITATION_EXPIRE_DAYS=7
